# ==============================================================================
# Agendra — Environment Variables Example
# Copie este arquivo para `.env.local` e preencha os valores reais.
# NUNCA commite `.env.local` ou chaves reais no repositório.
# ==============================================================================

# ── 1. Supabase (OBRIGATÓRIO) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 2. App URLs (OBRIGATÓRIO) ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.agendra.site
# Apenas desenvolvimento local: sobrescreve a base de redirect_uri para OAuth
# (Instagram, Google) e callbacks internos. Use http://localhost:3000 localmente.
# Em produção (Vercel), deixe vazio.
SERVER_APP_URL=

# ── 3. Provedores de IA (OBRIGATÓRIO: ao menos GOOGLE_AI_API_KEY) ──────────────
# Gemini é o provedor primário do router (chat, tools, bg) e embeddings RAG (768d)
GOOGLE_AI_API_KEY=
# Fallbacks do router de IA + transcrição de áudio (Groq Whisper)
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GROQ_API_KEY=
# Opcional: usado apenas para TTS (Text-to-Speech) no WhatsApp quando ENABLE_TTS=true
OPENAI_API_KEY=

# ── 4. Upstash Redis & QStash (RECOMENDADO — debounce, dedup, cache, circuit breaker)
# Conexão principal TCP via ioredis (máxima performance)
UPSTASH_REDIS_URL=
# Fallback via REST API (usado caso UPSTASH_REDIS_URL não esteja definido)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash — agendamento serverless-native do debounce flush (/api/internal/flush).
# Se ausente (ou em localhost), faz fallback para setTimeout local / cron flush-buffer.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Opcional: endpoint regional caso sua conta não esteja na região padrão (ex: https://qstash.us-east-1.upstash.io)
QSTASH_URL=

# ── 5. WhatsApp Cloud API / Meta (OBRIGATÓRIO para canal WhatsApp) ─────────────
NEXT_PUBLIC_META_APP_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — validação HMAC X-Hub-Signature-256 e troca de tokens
WHATSAPP_APP_SECRET=

# ── 6. Instagram Messaging / Meta (OPCIONAL — apenas se usar canal Instagram) ──
NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# ── 7. Google Calendar OAuth2 (OBRIGATÓRIO para agendamento com GCal) ──────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apenas dev local: http://localhost:3000/api/auth/google
# Em produção, deixe vazio (usa NEXT_PUBLIC_APP_URL + /api/auth/google)
GOOGLE_REDIRECT_URI=

# ── 8. Stripe Billing (OBRIGATÓRIO para checkout, portal e webhooks) ───────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── 9. E-mail via Gmail SMTP / Nodemailer (OBRIGATÓRIO para OTP, convites, contato)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── 10. Segurança: Cron & Painel Admin (OBRIGATÓRIO em produção) ───────────────
CRON_SECRET=
# Autenticação secundária do painel /admin (sem fallback seguro)
ADMIN_PASSWORD=
ADMIN_SESSION_SALT=
# Lista separada por vírgula (ex: admin1@dominio.com,admin2@dominio.com)
ADMIN_EMAILS=
# Alias legado opcional (singular) — prefira ADMIN_EMAILS
# ADMIN_EMAIL=

# ── 11. Feature Flags & Tuning (OPCIONAL) ──────────────────────────────────────
# OAUTH_STATE_SECRET=
# CHANNEL_CACHE_KEY=
# DISABLE_CHANNEL_CACHE=false
# ENABLE_TTS=false
# ENABLE_FINTECH=false
# DEBUG_WHATSAPP=false
# AI_TURN_BUDGET_MS=270000
# AI_CLEANUP_RESERVE_MS=8000
