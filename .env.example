NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=https://www.agendra.site
# Local dev only: overrides redirect_uri base for OAuth flows (Instagram, Google).
# Set to http://localhost:3000 locally. Leave unset in production (Vercel).
SERVER_APP_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

NEXT_PUBLIC_META_APP_ID=     # Meta App ID (público — usado no SDK Facebook e OAuth)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=         # Meta App Secret (para validação X-Hub-Signature-256 e token exchange)

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Gmail SMTP (Nodemailer email service)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# AI API Providers (Groq, Google, Cerebras, SambaNova)
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# Upstash Redis (Wave 1 debounce + dedup)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash — debounce flush scheduling (serverless-native delayed delivery).
# If QSTASH_TOKEN is unset, debounce falls back to inline wait (dev) / DB buffer.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Active Deadline Supervisor (optional overrides; defaults shown)
# AI_TURN_BUDGET_MS=270000
# AI_CLEANUP_RESERVE_MS=8000

# Cron
CRON_SECRET=


# Admin panel secondary auth (REQUIRED — sem default seguro)
ADMIN_PASSWORD=
ADMIN_SESSION_SALT=
ADMIN_EMAILS=
